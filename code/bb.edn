{:min-bb-version "1.12.0"
 ;; runtime deps + :paths come from deps.edn (the canonical manifest)
 :deps {local/project {:local/root "."}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])
  :init (do (def src-dirs (filterv fs/directory? ["src" "examples" "test" "dev"]))
            ;; the repo's bb scripts are linted and formatted along with the project
            ;; (kondo skips *.bb when walking a dir, so pass the files)
            (def scripts (mapv str (sort (fs/glob "../scripts" "*.bb"))))
            (defn test-nses []
              (->> (fs/glob "test" "**_test.clj")
                   ;; bb.edn is EDN: no #() or #"" literals
                   (map (fn [p]
                          (-> (str (fs/relativize "test" p))
                              (str/replace ".clj" "")
                              (str/replace "_" "-")
                              (str/replace fs/file-separator ".")
                              symbol)))
                   sort)))

  ;; org tooling in ../scripts (needs emacs; same as make lint/tangle/diagrams)
  org:lint     {:doc "org-lint every .org file in the repo"
                :task (shell "bb ../scripts/lint-org.bb")}

  org:tangle   {:doc "Tangle every .org file in the repo (org is the source of truth)"
                :task (shell "bb ../scripts/tangle-all.bb")}

  org:diagrams {:doc "Render the mermaid blocks in every .org file (needs ob-mermaid)"
                :task (shell "bb ../scripts/generate-diagrams.bb")}

  test    {:doc "Run the test suite on the JVM (clojure -M:test)"
           :task (apply shell "clojure -M:test" *command-line-args*)}

  test:bb {:doc "Run the same test namespaces under babashka"
           :extra-paths ["test"]
           :task (let [nses (test-nses)]
                   (apply require nses)
                   (let [{:keys [fail error]} (apply clojure.test/run-tests nses)]
                     (when (pos? (+ fail error))
                       (throw (ex-info "bb tests failed" {:fail fail :error error})))))}

  lint    {:doc "Lint with clj-kondo (fails on errors, reports warnings)"
           :task (apply shell "clojure -M:lint --fail-level error --lint" (concat src-dirs scripts))}

  fmt     {:doc "Check formatting with cljfmt"
           :task (apply shell "clojure -M:fmt check" (concat src-dirs scripts))}

  fmt:fix {:doc "Fix formatting with cljfmt"
           :task (apply shell "clojure -M:fmt fix" (concat src-dirs scripts))}

  check   {:doc "lint + fmt + test + test:bb (what CI runs)"
           :depends [lint fmt test test:bb]}}}
